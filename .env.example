# Dairy Farm Manager — environment variables
#
# This file documents the variables the app understands. Copy the values you
# need into the environment that runs the server (Render dashboard, shell,
# Electron, etc.). Do NOT commit a real .env file.

# ---------------------------------------------------------------------------
# Database selection
# ---------------------------------------------------------------------------
# Set DATABASE_URL to run the online PostgreSQL edition.
# Leave it unset to run the local SQLite edition (desktop/Electron/default dev).
# DATABASE_URL=postgresql://user:password@host:5432/database

# SQLite database file (local edition only; ignored when DATABASE_URL is set).
# DB_PATH=./data/dairy.db

# Directory for automatic/manual SQLite backups (local edition only).
# BACKUP_DIR=./data/backups

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# NODE_ENV=production
# PORT=4000
# HOST=0.0.0.0            # defaults to 127.0.0.1 locally, 0.0.0.0 in production

# Comma-separated list of allowed browser origins for the API (CORS).
# Required only when the frontend is hosted on a different origin than the API.
# Wildcards are not supported and not allowed in production.
# FRONTEND_ORIGIN=https://dairy-farm-frontend.onrender.com

# ---------------------------------------------------------------------------
# Frontend build (client/.env or build environment only)
# ---------------------------------------------------------------------------
# Optional API origin for a separately hosted frontend. Leave unset to keep the
# default same-origin relative /api requests (recommended single-service setup).
# VITE_API_BASE_URL=https://dairy-farm-api.onrender.com
